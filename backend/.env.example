# --- Multi-provider LLM keys (server-side fallback when client doesn't send X-Api-Key) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

# --- GitHub integration (Phase 1.3) ---
GITHUB_TOKEN=
GITHUB_DEFAULT_REPO=          # e.g. "owner/repo"

# --- Security ---
VAULT_SECRET=change-me-to-a-32-byte-random-string

# --- Sandbox (Phase 1.2) ---
DOCKER_HOST=                  # leave empty for local engine; tcp://host:2375 for remote
SANDBOX_MEMORY_MB=512
SANDBOX_TIMEOUT_S=60
SANDBOX_NETWORK=none

# --- Server ---
CORS_ORIGINS=http://localhost:3000
